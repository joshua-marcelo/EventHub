# Copy to .env.local and fill in values from the client's Supabase project.
# Never commit real values. Never add a service-role/secret key here — the app does not need one.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public base URL of this app, without trailing slash.
# Used for auth email redirects now, and later for invite/attendance/certificate QR links.
# Local: http://localhost:3000   Production: https://<your-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000
