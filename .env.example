# Copy to .env.local and fill in values from the client's Supabase project.
# Never commit real values. Privileged credentials must remain server-only.
#
# Environments (docs/SYSTEM_SPEC.md §22, DECISIONS.md D-016):
# - Development: project ref ldhpbfujqnyovovabvcg (local .env.local and AI/MCP tooling point here).
# - Production: a separate project created before deployment; its values are set only in Vercel.

# Supabase project URL (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable (anon) key (Project Settings → API Keys)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server ONLY: Supabase secret key (or legacy service-role key), used for Admin invitations.
# Never prefix this variable with NEXT_PUBLIC_. Never paste the real value into this example.
SUPABASE_SECRET_KEY=

# Public base URL of this app, without trailing slash.
# Used for auth email redirects now, and later for invite/attendance/certificate QR links.
# Local: http://localhost:3000   Production: https://<your-domain>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: Cloudflare Turnstile site key (P-01). When set, auth forms show the CAPTCHA and send
# its token to Supabase. Supabase Auth must have CAPTCHA enabled with the matching secret key
# (dashboard only; never put the secret here). Test key that always passes: 1x00000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
